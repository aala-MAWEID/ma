{
  "name": "maweid",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "prebuild": "node scripts/audit-logical-props.mjs && node scripts/i18n-audit.mjs",
    "build": "node scripts/audit-logical-props.mjs && node scripts/i18n-audit.mjs && tsc -b && vite build",
    "build:pages": "vite build && node scripts/pages-fallback.mjs",
    "preview:pages": "vite preview --port=4173",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:rtl": "node scripts/audit-logical-props.mjs",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
